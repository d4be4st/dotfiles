[user]
  email = d4be4st@gmail.com
  name = Stjepan Hadjic
	signingkey = /Users/stef/.ssh/id_ed25519.pub
[core]
  excludesfile = /Users/stef/.gitignore
  editor = nvim
  ignorecase = false
  pager = delta
  autocrlf = input
[push]
  default = current
  autoSetupRemote = true
[color]
  ui = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
[diff]
  colorMoved = default
[mergetool "diffconflicts"]
  cmd = nvim -c DiffviewOpen
  trustExitCode = true
[mergetool]
  keepBackup = false
[merge]
  tool = diffconflicts
[pull]
  rebase = true
[rebase]
  autoStash = true
  autosquash = true
[rerere]
  enabled = true
[gpg]
  format = ssh
[commit]
  gpgsign = true
[init]
  defaultBranch = master
[credential]
	username = d4be4st
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
