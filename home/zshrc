# ~/.zshrc — interactive shells only
# Heavy login stuff (brew, mise, gcloud PATH) lives in ~/.zprofile

source ~/.zsh/plugins.zsh
source ~/.zsh/path.zsh
source ~/.zsh/prompt.zsh
source ~/.zsh/tools.zsh
source ~/.zsh/mappings.zsh

for file in ~/.zsh/aliases/*.zsh; do source "$file"; done

alias idle='/Users/stef/.claude/skills/idle/idle.sh'
