# ~/.zprofile — login shell only (runs once at login, not on every new tab)

# OrbStack
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# Homebrew + language managers
if [ "$(arch)" = "arm64" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    command -v mise >/dev/null && eval "$(mise activate zsh)"
    export GITHUB_TOKEN=$(gh auth token 2>/dev/null)
else
    eval "$(/usr/local/bin/brew shellenv)"
    alias d4="gameportingtoolkit-no-hud ~/WinGames 'C:\Program Files (x86)\Diablo IV\Diablo IV Launcher.exe'"
    export WINEPREFIX=~/my-game-wine
fi

# Google Cloud SDK
if [ -f '/Users/stef/Downloads/google-cloud-sdk/path.zsh.inc' ]; then
    . '/Users/stef/Downloads/google-cloud-sdk/path.zsh.inc'
fi
export PATH="$HOME/.local/bin:$PATH"

# keg-only mysql-client (brew won't symlink it; /prod-db needs `mysql` on PATH)
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# Overmind: don't load ~/.tmux.conf into overmind's embedded tmux servers —
# keeps tpm/continuum (session auto-save/restore) out of dev-server tmux.
export OVERMIND_TMUX_CONFIG=/dev/null

# Productive: load API tokens from macOS Keychain
[ -f "/Users/stef/dev/productive/work/scripts/load-secrets.sh" ] && source "/Users/stef/dev/productive/work/scripts/load-secrets.sh"
# Productive: configure Claude Code OTel telemetry export
[ -f "/Users/stef/dev/productive/work/scripts/load-otel.sh" ] && source "/Users/stef/dev/productive/work/scripts/load-otel.sh"
