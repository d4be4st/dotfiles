{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "column",
  "children": [
    {
      "id": "glados-top",
      "type": "block",
      "content": {
        "mod": "glados-top"
      },
      "size": {
        "px": 34
      },
      "background": "chrome",
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "glados-chrome"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "glados-sidebar",
              "type": "block",
              "content": {
                "mod": "glados-sidebar"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "glados-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 69
              }
            }
          ],
          "size": {
            "px": 300
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "px": 28
              }
            }
          ],
          "resizable": false
        }
      ]
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "catppuccin-latte",
    "dark": "catppuccin-mocha"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
